{
  "name": "uptime-watchdog",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "set -a; . ./.dev.env; set +a; bun run --parallel --filter '*' dev",
    "build": "bun run typecheck && bun run test && bun run lint && bun scripts/build.ts",
    "start": "if [ -f .prod.env ]; then set -a; . ./.prod.env; set +a; fi; sh builds/current/run",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  }
}
